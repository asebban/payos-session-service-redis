<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>ma.s2m.payos</groupId>
        <artifactId>payos-parent</artifactId>
        <version>1.1.2-RELEASE</version>
        <relativePath>../payos-parent/pom.xml</relativePath>
    </parent>

    <artifactId>session-service-redis</artifactId>
    <version>1.0.0-RELEASE</version>
    <packaging>jar</packaging>

    <name>session-service-redis</name>
    <description>Redis implementation of ISessionStore for the PayOS platform (distributed OIDC session storage)</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ma.s2m.payos</groupId>
                <artifactId>payos-core-bom</artifactId>
                <version>1.8.0-RELEASE</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- PayOS kernel — provided by the runtime -->
        <dependency>
            <groupId>ma.s2m.payos</groupId>
            <artifactId>payos-kernel</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Jackson — already on the runtime classpath via payos-kernel, version managed transitively -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Redis client -->
        <dependency>
            <groupId>io.lettuce</groupId>
            <artifactId>lettuce-core</artifactId>
            <version>6.5.1.RELEASE</version>
        </dependency>

        <!-- Logging API — provided by the runtime -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <version>5.23.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
